Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Vamos", " ", "a", " ", "poner", " ", "restricciones"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], "\n", 
   RowBox[{"g", "[", "x", "]"}], "\n", 
   RowBox[{"h", "[", "x", "]"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Sinoidal", " ", "->", " ", 
     RowBox[{"Cuadratica", " ", "->", " ", "cubica"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"restric", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "->", "\[Alpha]"}], ",", 
       RowBox[{
        RowBox[{"C", "[", "4", "]"}], "->", "0"}], ",", 
       RowBox[{
        RowBox[{"C", "[", "3", "]"}], "->", "0"}], ",", 
       RowBox[{
        RowBox[{"C", "[", "5", "]"}], "->", 
        RowBox[{"C", "[", "2", "]"}]}], ",", 
       RowBox[{
        RowBox[{"C", "[", "4", "]"}], "->", 
        RowBox[{"C", "[", "7", "]"}]}]}], "}"}]}], "*)"}], "\n", 
   RowBox[{"restric1", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "->", "\[Alpha]"}], ",", 
      RowBox[{
       RowBox[{"C", "[", "9", "]"}], "->", 
       RowBox[{"2", 
        RowBox[{"Pi", "/", "l"}]}]}]}], "}"}]}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Sinoidal", " ", "->", " ", "Cuadratica"}], " ", "*)"}], "\n", "\n", 
   RowBox[{"eqn1", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"h", "[", "x", "]"}], "==", 
       RowBox[{"g", "[", "x", "]"}]}], ")"}], "/.", "restric1"}]}], "\n", 
   RowBox[{"eqn2", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"h", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "==", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"g", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], ")"}], "/.", 
     "restric1"}]}], "\n", 
   RowBox[{"eqn3", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"h", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "1"}], "}"}]}], "]"}], "==", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"g", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "1"}], "}"}]}], "]"}]}], ")"}], "/.", 
     "restric1"}]}], "\n", "\n", 
   RowBox[{"sol1", "=", 
